# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Node
node_modules/
dist/
build/
*.log

# Databases — the SQLite file is local state, never committed
*.db
*.db-journal
*.sqlite
*.sqlite3

# Telemetry — a record of a local session. Never committed: it is machine-local
# diagnostic state by definition (Principle VII), and a committed one would be
# the exact privacy failure FR-011 exists to prevent.
telemetry.jsonl
telemetry.jsonl.*
e2e-telemetry.jsonl
e2e-telemetry.jsonl.*

# Playwright
playwright-report/
test-results/
blob-report/
.playwright/

# Environment
.env
.env.*
!.env.example

# Editors / OS
.DS_Store
Thumbs.db
*.swp
*.tmp
.vscode/
.idea/

# Local database backups
*.bak
