{
  "components": {
    "schemas": {
      "ErrorDetail": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "field": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Field"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorResponse": {
        "description": "The single error shape for every non-2xx response.",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "TaskCreate": {
        "additionalProperties": false,
        "description": "Request body for creating a task.",
        "properties": {
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "title"
        ],
        "title": "TaskCreate",
        "type": "object"
      },
      "TaskRead": {
        "description": "Response body for a single task.",
        "properties": {
          "completed": {
            "title": "Completed",
            "type": "boolean"
          },
          "completed_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Completed At"
          },
          "created_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Created At"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "completed",
          "created_at",
          "completed_at"
        ],
        "title": "TaskRead",
        "type": "object"
      },
      "TaskUpdate": {
        "additionalProperties": false,
        "description": "Request body for mutating an existing task.\n\nThere is deliberately **no** ``title`` field. Its absence is how FR-007\n(\"a task's title MUST NOT be editable after creation\") is enforced: with\n``extra=\"forbid\"`` there is no code path by which a title could change,\nand an attempt to send one is reported rather than silently ignored.",
        "properties": {
          "completed": {
            "title": "Completed",
            "type": "boolean"
          }
        },
        "required": [
          "completed"
        ],
        "title": "TaskUpdate",
        "type": "object"
      },
      "TelemetryReport": {
        "additionalProperties": false,
        "description": "One failure, observed in the browser.",
        "properties": {
          "code": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Z0-9_]+$",
            "title": "Code",
            "type": "string"
          },
          "duration_ms": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Duration Ms"
          },
          "operation": {
            "enum": [
              "task_created",
              "task_completed",
              "task_reopened",
              "task_deleted",
              "task_list_read"
            ],
            "title": "Operation",
            "type": "string"
          }
        },
        "required": [
          "operation",
          "code"
        ],
        "title": "TelemetryReport",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Core todo API for a single local user.",
    "title": "TaskFlow",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/tasks": {
      "get": {
        "description": "Return all tasks already sorted \u2014 the client never re-sorts.",
        "operationId": "list_tasks_api_tasks_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/TaskRead"
                  },
                  "title": "Response List Tasks Api Tasks Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List every task in display order",
        "tags": [
          "tasks"
        ]
      },
      "post": {
        "description": "Create a task. The title arrives raw; the schema has already trimmed\nand validated it through the same function the service uses.",
        "operationId": "create_task_api_tasks_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TaskCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskRead"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Validation failed"
          }
        },
        "summary": "Create a task",
        "tags": [
          "tasks"
        ]
      }
    },
    "/api/tasks/{task_id}": {
      "delete": {
        "description": "Permanent. Deleting an id that does not exist returns 404 rather than\n204 \u2014 the client has stale state and should be told, not reassured.",
        "operationId": "delete_task_api_tasks__task_id__delete",
        "parameters": [
          {
            "in": "path",
            "name": "task_id",
            "required": true,
            "schema": {
              "title": "Task Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "No such task"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Delete a task permanently",
        "tags": [
          "tasks"
        ]
      },
      "patch": {
        "description": "The only mutation on an existing task.\n\n``TaskUpdate`` carries exactly one field, so there is no code path by\nwhich a title could change (FR-007).",
        "operationId": "update_task_api_tasks__task_id__patch",
        "parameters": [
          {
            "in": "path",
            "name": "task_id",
            "required": true,
            "schema": {
              "title": "Task Id",
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TaskUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskRead"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "No such task"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Validation failed"
          }
        },
        "summary": "Complete a task, or return it to active",
        "tags": [
          "tasks"
        ]
      }
    },
    "/api/telemetry": {
      "post": {
        "description": "Record a failure the browser observed. Always answers 204.\n\n**Including when recording did nothing.** This endpoint exists to report\nfailures; if it answered with an error when the sink was broken, the\nbrowser would have a failed request to report, which would fail, and so\non. Making the failure unobservable to the caller is the simplest way to\nstop that loop (FR-006a).\n\nA malformed body is not an exception to this. That is a defect in the\ncaller rather than a runtime failure, and it should be loud \u2014 so it\nleaves as a 422 through the usual envelope.\n\nNothing here is transmitted anywhere: the entry goes to a file on this\nmachine, and this route is the local server the browser already talks to.",
        "operationId": "report_api_telemetry_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TelemetryReport"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Validation failed"
          }
        },
        "summary": "Report a browser-side failure to the local record",
        "tags": [
          "telemetry"
        ]
      }
    }
  }
}
